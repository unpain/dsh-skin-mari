{
  "name": "dsh-skin-mari",
  "description": "A Unit-08 optical test-lab interface in magenta, smoked plum, acid green, and warm ivory.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skin.json": "./skin.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-skin-switch"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/sync-client-bundle.mjs",
    "build:check": "node scripts/sync-client-bundle.mjs --check",
    "test": "vitest run"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-skin-switch": "0.1.0"
  },
  "peerDependenciesMeta": {
    "dsh-skin-switch": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "jsdom": "29.1.1",
    "vitest": "4.1.10"
  },
  "files": [
    "assets/*.webp",
    "lib",
    "preview/*.webp",
    "preview/preview.html",
    "scripts",
    "shared",
    "src",
    "tests",
    "cordis.patch.yml",
    "skin.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE"
  ]
}
